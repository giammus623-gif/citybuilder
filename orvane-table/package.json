{
  "name": "orvane-table",
  "private": true,
  "version": "0.1.0",
  "description": "Project Orvane Table: sito, prenotazioni e assistente AI per ristoranti indipendenti, a investimento zero.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
