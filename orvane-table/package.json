    "siti": "tsx tools/genera-siti.ts",
    "assistente": "tsx tools/assistente.ts",
    "modello": "tsx tools/modello-finanziario.ts",
    "rapporto": "tsx tools/rapporto.ts",
    "analisi": "tsx tools/analisi-settimanale.ts",
    "esporta": "tsx tools/esporta.ts",
    "nuovo-locale": "tsx tools/nuovo-locale.ts",
    "proposta": "tsx tools/proposta.ts",
    "foglio": "python3 tools/foglio_kpi.py",
